# Used by "npm run build". Contains no secrets; anything here ends up in the public JS bundle.

# Where the Flask API lives.
#   Empty = same domain as the admin site (CloudFront forwards /api/* to the back end).
#   If the API has its own domain instead, put it here, e.g. https://api.yourdomain.com
#   (and add the admin site's URL to the back end's CORS_ORIGINS).
VITE_API_URL=

VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_API=false
