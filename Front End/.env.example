# Copy this file to ".env.local" and edit. ".env.local" is not committed.

# Where the Flask back end runs
VITE_API_URL=http://127.0.0.1:5000

# true  = demo login (no back end needed)
# false = call the real login endpoint
VITE_USE_MOCK_AUTH=true

# true  = admin pages (appointments, ...) use built-in demo data
# false = admin pages call the real API
VITE_USE_MOCK_API=true
