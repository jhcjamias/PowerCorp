# Copy this file to ".env.local" and edit. ".env.local" is not committed.

# Where the Flask back end runs
VITE_API_URL=http://127.0.0.1:5000

# false = call the real login endpoint (recommended)
# true  = local mock login for isolated UI work
VITE_USE_MOCK_AUTH=false

# false = admin pages call the real API (recommended)
# true  = admin pages use local mock data for isolated UI work
VITE_USE_MOCK_API=false
