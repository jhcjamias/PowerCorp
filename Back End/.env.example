# Deployment environment checklist. Do not put real secrets in this file.
# Flask reads these values from the operating system or hosting platform.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret

# MySQL connection
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Local customer and admin origins. Replace these with the production site origin when deployed.
CORS_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:5173

# Google Places API (New). Enable Places API (New) and billing in Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_URL=https://www.google.com/maps/place/Rolaz+Cutz+Barbershop/

# Instagram API with Instagram Login for the Rolaz professional account.
# The access token needs instagram_business_basic permission.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=me
INSTAGRAM_GRAPH_VERSION=v27.0

# The Staff row used for the single booking chair.
BARBER_STAFF_ID=
